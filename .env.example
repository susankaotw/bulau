## Copy to .env and fill values
#
# Required for running inside Docker:
# - VERCEL_TOKEN: create in Vercel dashboard (Account Settings -> Tokens)
VERCEL_TOKEN=your_vercel_token

OPENAI_API_KEY=your_openai_api_key
NOTION_API_KEY=your_notion_api_key
NOTION_MEMBER_DB_ID=your_value
NOTION_DB_ID=your_value
RECORD_DB_ID=your_value
LINE_CHANNEL_ACCESS_TOKEN=your_value
LINE_CHANNEL_SECRET=your_value
BULAU_GUARD_URL=https://localhost:3000/api/guard
BULAU_ANSWER_URL=http://localhost:3000/api/answer
AI_CANDIDATE_DB_ID=your_value
GEN_MODE=your_value
NOTION_TOKEN=your_notion_token
